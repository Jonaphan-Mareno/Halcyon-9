# Optional Apache settings for Halcyon-9 (see DEPLOY.md).
# To use: copy this file into the game's folder on the server and rename it to .htaccess.
# If the game then shows "500 Internal Server Error", the server does not allow these settings:
# just delete the .htaccess again (the game works without it, it only loads a little slower).

# File types the browser needs to be told about
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/wasm .wasm
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType text/javascript .js .mjs
</IfModule>

# Compress the code and data on the way out (the 4 MB physics engine becomes ~1.7 MB)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/wasm image/svg+xml
</IfModule>

# Caching: files with a content hash in their name (assets/index-AbC123xy.js) never change, so
# browsers can keep them; everything else is re-checked each visit (a quick "not modified")
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(glb|webp|jpg|png|mp3|mp4)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
